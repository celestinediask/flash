# Everything here is optional. UI_SECRET_KEY and POSTBACK_SECRET are generated into .env when you create your account.
# APP_NAME=Orders          # title shown in the page
# UI_HOST=127.0.0.1
# UI_PORT=8081
# POSTBACK_HOST=127.0.0.1
# POSTBACK_PORT=8080

# First-run default broker (otherwise dhan), and env fallbacks for broker settings
# BROKER=dhan
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=
# DHAN_BASE_URL=https://api.dhan.co/v2

# SQLite database (logs); default is flash.db next to the code
# DB_PATH=
